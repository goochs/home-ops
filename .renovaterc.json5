{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>home-operations/renovate-presets#10.0.1',
    'github>home-operations/renovate-presets//apps/cnpg.json5#10.0.1',
    'github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.1',
    ':timezone(America/New_York)',
  ],
  rebaseWhen: 'conflicted',
  packageRules: [
    {
      description: 'Auto-merge trusted OCI minors',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      matchPackageNames: [
        'ghcr.io/home-operations{/,}**',
        'ghcr.io/goochs/{/,}**',
      ],
    },
    {
      description: 'Auto-merge GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '3 days',
      ignoreTests: false,
    },
    {
      description: 'Auto-merge trusted GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        '/^actions\\//',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '1 minute',
      ignoreTests: false,
    },
    {
      description: 'Auto-merge Grafana dashboards',
      matchDatasources: [
        'custom.grafana-dashboards',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
    {
      description: 'Auto-merge Renovate Presents',
      matchManagers: [
        'renovate-config',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
    {
      description: 'Auto-merge prometheus CRDs',
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'pr',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '/prometheus-operator-crds/',
      ],
      ignoreTests: false,
    },
    {
      description: 'Auto merge all patches',
      matchDatasources: [
        'helm',
        'docker',
      ],
      automerge: true,
      automergeType: 'pr',
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      matchCurrentVersion: '!/^0/',
    },
    {
      description: 'Actions Runner Controller Group',
      groupName: 'actions-runner-controller',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/gha-runner-scale-set-controller/',
        '/gha-runner-scale-set/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Flux Operator Group',
      groupName: 'flux-operator',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/flux-operator/',
        '/flux-instance/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Kubernetes Group',
      groupName: 'kubernetes',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/kube-apiserver/',
        '/kube-controller-manager/',
        '/kube-proxy/',
        '/kube-scheduler/',
        '/kubelet/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 5,
    },
    {
      description: 'Mise Tools Group',
      matchManagers: [
        'mise',
      ],
      groupName: 'mise tools',
      groupSlug: 'mise-tools',
    },
    {
      description: 'Immich Group',
      groupName: 'Immich',
      matchPackageNames: [
        '/immich-app/',
      ],
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: '1Password Group',
      groupName: '1password',
      matchPackageNames: [
        '/1password/',
      ],
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'VictoriaMetrics Group',
      groupName: 'victoriametrics',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/victoriametrics/helm-charts/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Rook-Ceph Group',
      groupName: 'rook-ceph',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/rook-ceph/',
        '/rook-ceph-cluster/',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Talos Group',
      groupName: 'talos',
      matchPackageNames: [
        'siderolabs/talos',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      minimumGroupSize: 2,
    },
    {
      description: 'Keep CloudNativePG on Postgres 18 until the extension images move with it',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      allowedVersions: '/^18\\./',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'type/patch',
      ],
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      addLabels: [
        'type/digest',
      ],
    },
  ],
}
